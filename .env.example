# Porta do servidor
PORT=3000

# Segredo usado para assinar os tokens de login do painel (gere um valor aleatorio longo)
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-bem-longo

# Hash bcrypt da senha do painel admin.
# Gere com: npm run hash-password -- "sua-senha-aqui"
ADMIN_PASSWORD_HASH=

# Origem permitida para CORS (opcional). Use "*" em desenvolvimento
# ou o dominio publico do painel/TVs em producao, ex: https://sinalizacao.seudominio.com
CORS_ORIGIN=*
